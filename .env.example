# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dev mode: enables email/password login and skips OTP (set to false in production)
EXPO_PUBLIC_DEV_MODE=true

# M-Pesa API (for frontend payment initiation)
EXPO_PUBLIC_MPESA_API_URL=http://localhost:3000

# Google Maps API (if using maps)
GOOGLE_MAP_API_KEY=your-google-maps-api-key
