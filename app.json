{
  "expo": {
    "name": "Mama Mboga",
    "slug": "mama-mboga",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.benaa.mamamboga"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E7D32"
      },
      "package": "com.benaa.mamamboga"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mama Mboga to access your photos to upload product images."
        }
      ]
    ],
    "scheme": "mamamboga",
    "experiments": {
      "typedRoutes": true
    }
  }
}
